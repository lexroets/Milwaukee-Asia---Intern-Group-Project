    const g=offlineTranslate('배터리 30개 부탁드립니다');
    ok('Glossary fallback for unknown text',!g.exact&&/battery/i.test(g.english),g.english.slice(0,40));
    ok('Language detection',detectLang('안녕')==='Korean'&&detectLang('你好')==='Chinese'&&detectLang('สวัสดี')==='Thai'&&detectLang('hello')==='English');
    ok('All five channels defined',Object.keys(CHANNELS).length===5&&Object.values(CHANNELS).every(c=>c.colour&&c.name));
    ok('Simulator script covers 4 languages',new Set(SIM_SCRIPT.map(m=>detectLang(m.text))).size===4);
    ok('Room code is 4 characters',/^[A-Z0-9]{4}$/.test(busRoom()),busRoom());
    ok('Phone link carries the room',phoneURL().indexOf('#phone='+busRoom())>0);
    const r1=retrieve('배터리 보증',3);
    ok('Retrieval — Korean alias',r1.length>0&&/warranty|battery/i.test(r1[0].d.t+r1[0].d.b),r1[0]?r1[0].d.t.slice(0,24):'none');
    ok('Retrieval — rejects nonsense',retrieve('xylophone quantum bratwurst',3).length===0);
    ok('Retrieval — messaging channel doc reachable',retrieve('wechat webhook official account',3).some(h=>/messaging channel/i.test(h.d.t)));
    let bad=0;for(let d=0;d<DISTS.length;d++)for(let s=0;s<SKUS.length;s++){
      const x=series(d,s);if(x.hist.length!==18||x.fc.length!==3||x.conf<55||x.conf>97)bad++;}
    ok('Forecast — all 20 combinations valid',bad===0,bad+' invalid');
    let pass=0;for(let d=0;d<DISTS.length;d++)for(let s=0;s<SKUS.length;s++)if(series(d,s).conf>=78)pass++;
    ok('Underwriting gate has a real spread',pass>0&&pass<20,pass+'/20 pass');
    const scored=REGIONS.map(r=>oppScore(r));
    ok('White space — all regions scored',scored.every(s=>s>0&&s<=100));
    ok('White space — coverage penalises Seoul',REGIONS.map(r=>({n:r[0],s:oppScore(r)})).sort((a,b)=>b.s-a.s)[0].n!=='Seoul');
    ok('White space — actions across all bands',new Set(scored.map(oppAction)).size===3);
    ok('Conversion — high-value case is subsidised',convEcon(0,2,6).worth===true);
    ok('Conversion — heavy investment in low-buying trade refused',convEcon(0,3,12).worth===false,'payback '+convEcon(0,3,12).payback+'m');
    ok('Conversion — subsidy capped',convEcon(2,2,12).subsidy<=520);
    ok('Entry kit for every trade',TRADES.every(t=>(KITS[t[0]]||[]).length>=4));
    ok('Offline offer renders Korean',/밀워키/.test(offlineOffer(40,'대성공구','M18')));
    ok('Offline answer refuses when no match',/not covered/i.test(offlineAnswer('zzz',[])));
    ok('Knowledge base seeded',KB.length>=13&&KB.some(d=>d.s==='assumption'),KB.length+' docs');
    ok('Cache keys distinct',hash('abc')!==hash('abd'));
  }catch(e){ok('Self-test crashed',false,e.message);}
  const pass=T.filter(t=>t.c).length;
  document.getElementById('testOut').innerHTML=
    '<div class="rowline" style="border-bottom:3px solid var(--red)"><span><b>'+pass+' / '+T.length+' checks passed</b></span><b style="color:'+(pass===T.length?'var(--ok)':'var(--red)')+'">'+(pass===T.length?'ALL GOOD':'ATTENTION')+'</b></div>'
    +T.map(t=>`<div class="rowline"><span style="color:${t.c?'var(--ok)':'var(--red)'}">${t.c?'✓':'✗'} ${esc(t.n)}</span><b style="color:var(--grey2);font-weight:400">${esc(t.d)}</b></div>`).join('');
}

/* ═════ PHONE APP ═════ */
const PH={room:'',ch:'wechat',name:'',client:null,bc:null};
const PH_QUICK=[
 {ch:'wechat',label:'补货订单',text:"你好，我们要补货：\nM18 冲击扳手 20 台\nM12 起子机 15 台\n5.0Ah 电池 40 个"},
 {ch:'wechat',label:'询问保修',text:"M18 电池充不进电，还在保修期内吗？"},
 {ch:'kakao',label:'주문',text:"M18 FUEL 임팩트 렌치 15개랑 배터리 5.0Ah 30개 부탁드립니다"},
 {ch:'line',label:'สั่งของ',text:"สว่านกระแทก M18 จำนวน 12 ตัว แบตเตอรี่ 5.0Ah 25 ก้อน"}
];
function phInit(){
  const sel=document.getElementById('phCh');
  Object.entries(CHANNELS).forEach(([id,c])=>{const o=document.createElement('option');o.value=id;o.textContent=c.name+' — '+c.region;sel.appendChild(o);});
  const m=location.hash.match(/#phone=?([A-Z0-9]{0,6})/i);
  if(m&&m[1])document.getElementById('phRoom').value=m[1].toUpperCase();
  document.getElementById('phInput').addEventListener('keydown',e=>{
    if(e.key==='Enter'&&!e.shiftKey){e.preventDefault();phSend();}});
}
async function phJoin(){
  const err=document.getElementById('phErr');err.classList.add('hidden');
  PH.room=document.getElementById('phRoom').value.trim().toUpperCase();
  PH.ch=document.getElementById('phCh').value;
  PH.name=document.getElementById('phName').value.trim()||'Distributor';
  if(!/^[A-Z0-9]{3,6}$/.test(PH.room)){err.textContent='Enter the room code shown on the desk.';err.classList.remove('hidden');return;}
  const c=CHANNELS[PH.ch];
  document.getElementById('phAv').textContent=c.short;
  document.getElementById('phAv').style.background=c.colour;
  document.getElementById('phAv').style.color=PH.ch==='kakao'?'#111':'#fff';
  document.getElementById('phTitle').textContent='MILWAUKEE® — '+c.name;
  document.getElementById('phSetup').classList.add('hidden');
  document.getElementById('phChat').classList.remove('hidden');
  document.getElementById('phQuick').innerHTML=PH_QUICK.map((q,i)=>`<button onclick="phQuick(${i})">${esc(q.label)}</button>`).join('');
  phSys('Joined room '+PH.room);
  // same-browser channel always on
  try{PH.bc=new BroadcastChannel('onechannel-'+PH.room);
    PH.bc.onmessage=ev=>{if(ev.data&&ev.data.type==='reply')phIn(ev.data.text);};}catch(e){}
  phStatus('connecting…');
  try{
    await loadScript('https://unpkg.com/mqtt@5.10.1/dist/mqtt.min.js');
    const topic='milwaukee/onechannel/'+PH.room;
    const cl=window.mqtt.connect('wss://broker.emqx.io:8084/mqtt',
      {clientId:'ocph_'+Math.random().toString(36).slice(2,10),connectTimeout:9000,reconnectPeriod:4000,keepalive:30});
    PH.client=cl;
    cl.on('connect',()=>{cl.subscribe(topic);phStatus('connected · '+PH.room);});
    cl.on('message',(t,p)=>{try{const d=JSON.parse(p.toString());if(d.type==='reply')phIn(d.text);}catch(e){}});
    cl.on('error',()=>phStatus('bridge unavailable — same-browser only'));
  }catch(e){phStatus('bridge unavailable — same-browser only');}
}
function phLeave(){
  if(PH.client){try{PH.client.end(true);}catch(e){}PH.client=null;}
  if(PH.bc){try{PH.bc.close();}catch(e){}PH.bc=null;}
  document.getElementById('phChat').classList.add('hidden');
  document.getElementById('phSetup').classList.remove('hidden');
  document.getElementById('phThread').innerHTML='';
}
function phStatus(s){setTxt('phStatus',s);}
function phSys(t){const d=document.createElement('div');d.className='ph-sys';d.textContent=t;
  const th=document.getElementById('phThread');th.appendChild(d);th.scrollTop=th.scrollHeight;}
function phOut(t){const d=document.createElement('div');d.className='ph-msg out';
  d.innerHTML=esc(t).replace(/\n/g,'<br>')+'<div class="meta">'+nowHM()+' · sent</div>';
  const th=document.getElementById('phThread');th.appendChild(d);th.scrollTop=th.scrollHeight;}
function phIn(t){const d=document.createElement('div');d.className='ph-msg in';
  d.innerHTML=esc(t).replace(/\n/g,'<br>')+'<div class="meta">MILWAUKEE® · '+nowHM()+'</div>';
  const th=document.getElementById('phThread');th.appendChild(d);th.scrollTop=th.scrollHeight;}
function phQuick(i){document.getElementById('phInput').value=PH_QUICK[i].text;phSend();}
function phSend(){
  const inp=document.getElementById('phInput'),t=inp.value.trim();
  if(!t)return;
  phOut(t);inp.value='';
  const payload={type:'msg',ch:PH.ch,from:PH.name,dist:'KR-0142',text:t,ts:Date.now()};
  if(PH.client){try{PH.client.publish('milwaukee/onechannel/'+PH.room,JSON.stringify(payload));}catch(e){}}
  if(PH.bc){try{PH.bc.postMessage(payload);}catch(e){}}
}

