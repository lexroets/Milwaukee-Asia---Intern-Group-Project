<style>
:root{
  --red:#DB011C; --red-dk:#A80016; --red-lt:#FDEFF1; --red-md:#F7CDD3;
  --ink:#0A0A0A; --char:#141416; --grey:#58585A; --grey2:#8A8A8D;
  --line:#DCDCDC; --line2:#EEEEEE; --bg:#FFFFFF; --bg2:#F4F4F4;
  --amber:#B87400; --amber-bg:#FFF6E0; --ok:#1E7F45; --ok-bg:#E8F5ED;
  --disp:'Barlow Condensed',sans-serif; --body:'Inter',sans-serif; --mono:'JetBrains Mono',monospace;
}
*{box-sizing:border-box;margin:0;padding:0}
body{background:var(--bg);color:var(--ink);font-family:var(--body);font-size:14px;line-height:1.6;-webkit-font-smoothing:antialiased}
.topbar{position:sticky;top:0;z-index:50;height:56px;background:var(--red);display:flex;align-items:center;gap:15px;padding:0 18px;color:#fff}
.wordmark{font-family:var(--disp);font-weight:700;font-size:22px;font-style:italic;white-space:nowrap}
.slash{width:1px;height:26px;background:rgba(255,255,255,.35);flex-shrink:0}
.appname{font-family:var(--disp);font-weight:600;font-size:15px;letter-spacing:2.6px;color:rgba(255,255,255,.85);white-space:nowrap}
.topbar .spacer{flex:1}
.pill{font-family:var(--mono);font-size:10px;letter-spacing:1px;text-transform:uppercase;padding:4px 9px;border:1px solid rgba(255,255,255,.45);color:#fff;white-space:nowrap;background:rgba(0,0,0,.12)}
.pill.ok{border-color:#8BE8AF;color:#B6F5CE}.pill.warn{border-color:#FFD98A;color:#FFE7B0}
.pill.bad{border-color:#fff;background:#fff;color:var(--red)}
.pill.link{cursor:pointer}.pill.link:hover{background:rgba(0,0,0,.3)}
.shell{display:flex;min-height:calc(100vh - 56px)}
.rail{width:80px;flex-shrink:0;background:var(--char);display:flex;flex-direction:column;align-items:center;padding:8px 0;position:sticky;top:56px;height:calc(100vh - 56px);overflow-y:auto}
.rail nav{display:flex;flex-direction:column;gap:1px;width:100%}
.rbtn{background:none;border:0;color:#8A8A8D;padding:10px 0;cursor:pointer;font-family:var(--disp);font-weight:600;font-size:11px;letter-spacing:1.2px;writing-mode:vertical-rl;height:90px;display:flex;align-items:center;justify-content:center;transition:.15s;width:100%}
.rbtn:hover{color:#fff;background:#232326}
.rbtn.on{color:#fff;background:var(--red)}.rbtn.on .n{color:#fff}
.rbtn .n{font-family:var(--mono);font-size:9px;color:var(--red);margin-bottom:6px}
.rbtn .dot{position:absolute;margin-left:26px;margin-top:-30px;width:8px;height:8px;background:var(--red);border-radius:50%;border:1.5px solid var(--char)}
button:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible,.kbdoc:focus-visible,.inbox-item:focus-visible{outline:3px solid var(--red);outline-offset:2px}
main{flex:1;min-width:0;padding:0 0 90px;max-width:1240px}
.pad{padding:0 34px}
.eyebrow{font-family:var(--mono);font-size:10px;letter-spacing:2.2px;color:var(--red);text-transform:uppercase;margin-bottom:9px}
h1{font-family:var(--disp);font-weight:700;font-size:48px;line-height:.95;text-transform:uppercase}
h2{font-family:var(--disp);font-weight:700;font-size:23px;text-transform:uppercase}
h3{font-family:var(--disp);font-weight:600;font-size:14px;letter-spacing:1.4px;text-transform:uppercase;color:var(--grey)}
.lede{color:var(--grey);font-size:15px;max-width:68ch;margin-top:13px}
.view{display:none;animation:in .25s ease}.view.on{display:block}
@keyframes in{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}
@media (prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
.masthead{background:var(--red);color:#fff;padding:32px 34px;position:relative;overflow:hidden}
.masthead::after{content:'';position:absolute;right:-70px;top:-40px;width:280px;height:280px;background:rgba(0,0,0,.09);transform:rotate(35deg)}
.masthead h1{color:#fff;font-size:54px;position:relative;z-index:1}
.masthead .lede{color:rgba(255,255,255,.92);position:relative;z-index:1}
.masthead .eyebrow{color:rgba(255,255,255,.75)}
.sechead{background:var(--ink);color:#fff;padding:20px 34px;margin-bottom:20px}
.sechead h1{color:#fff;font-size:38px}.sechead .eyebrow{color:#FF8A96}.sechead .lede{color:#C9C9CC}
.panel{background:var(--bg);border:1px solid var(--line);border-top:4px solid var(--red);padding:20px}
.panel.quiet{border-top:1px solid var(--line);background:#FBFBFB}
.panel.tint{background:var(--red-lt);border-color:var(--red-md);border-top:4px solid var(--red)}
.panel.red{background:var(--red);border-color:var(--red);color:#fff}
.panel.red h2{color:#fff}.panel.red h3{color:rgba(255,255,255,.8)}.panel.red .lede,.panel.red .note{color:rgba(255,255,255,.9)}
.panel.dark{background:var(--ink);border-color:var(--ink);color:#fff}
.panel.dark h2{color:#fff}.panel.dark h3{color:#8A8A8D}.panel.dark .lede{color:#C9C9CC}
.grid{display:grid;gap:13px}.g2{grid-template-columns:1fr 1fr}.g3{grid-template-columns:repeat(3,1fr)}.g4{grid-template-columns:repeat(4,1fr)}
.g5{grid-template-columns:repeat(5,1fr)}
.stack{margin-top:20px}
.kpi{background:var(--bg2);border:1px solid var(--line);border-left:4px solid var(--red);padding:14px 16px}
.kpi.solid{background:var(--red);border-color:var(--red);color:#fff}.kpi.solid .l{color:rgba(255,255,255,.85)}
.kpi.dark{background:var(--ink);border-color:var(--ink);color:#fff}.kpi.dark .l{color:#8A8A8D}
.kpi .v{font-family:var(--disp);font-weight:700;font-size:34px;line-height:1}
.kpi .v.red{color:var(--red)}.kpi .v.ok{color:var(--ok)}.kpi .v.am{color:var(--amber)}
.kpi .l{font-family:var(--mono);font-size:9.5px;letter-spacing:1.2px;color:var(--grey2);text-transform:uppercase;margin-top:7px}
.tag{display:inline-block;font-family:var(--mono);font-size:9.5px;letter-spacing:1.1px;text-transform:uppercase;padding:3px 8px;border:1px solid var(--line);color:var(--grey)}
.tag.am{border-color:#E5C36A;background:var(--amber-bg);color:var(--amber)}
.tag.ok{border-color:#9AD1B0;background:var(--ok-bg);color:var(--ok)}
.tag.red{border-color:var(--red);background:var(--red);color:#fff}
.tag.rout{border-color:var(--red);background:var(--red-lt);color:var(--red)}
.mono{font-family:var(--mono);font-size:12px}
button.act{font-family:var(--disp);font-weight:600;font-size:14px;letter-spacing:1.6px;text-transform:uppercase;background:var(--red);color:#fff;border:0;padding:12px 22px;cursor:pointer;transition:.15s}
button.act:hover{background:var(--red-dk)}button.act:disabled{background:#E9BCC1;cursor:not-allowed}
button.act.dark{background:var(--ink)}button.act.dark:hover{background:#333}
button.ghost{font-family:var(--disp);font-weight:600;font-size:12px;letter-spacing:1.3px;text-transform:uppercase;background:var(--bg);color:var(--ink);border:1px solid var(--line);padding:8px 14px;cursor:pointer}
button.ghost:hover{border-color:var(--red);color:var(--red)}
button.ghost.on{background:var(--ink);color:#fff;border-color:var(--ink)}
button.mini{background:none;border:1px solid var(--line);color:var(--grey2);font-family:var(--mono);font-size:10px;padding:3px 7px;cursor:pointer}
button.mini:hover{color:var(--red);border-color:var(--red)}
textarea,input,select{font-family:var(--mono);font-size:13px;background:var(--bg);color:var(--ink);border:1px solid var(--line);padding:11px;width:100%;resize:vertical}
textarea:focus,input:focus,select:focus{outline:none;border-color:var(--red)}
input.qty{width:66px;padding:5px 7px;text-align:right}
.note{font-size:12.5px;color:var(--grey2);margin-top:9px}
.err{color:var(--red);font-size:12.5px;margin-top:9px;font-weight:500}
.divider{height:1px;background:var(--line);margin:14px 0}.divider.red{height:3px;background:var(--red)}
.thread{background:var(--bg2);border:1px solid var(--line);padding:14px;max-height:420px;overflow-y:auto}
.bub{background:var(--bg);border:1px solid var(--line);border-left:3px solid var(--ink);padding:11px 13px;font-size:13.5px;margin-bottom:8px}
.bub.me{border-left-color:var(--red);background:var(--red-lt)}
.bub .who{font-family:var(--mono);font-size:9.5px;letter-spacing:1.1px;color:var(--grey2);text-transform:uppercase;margin-bottom:5px}
.cites{margin-top:9px;padding-top:8px;border-top:1px solid var(--line2);font-family:var(--mono);font-size:10px;color:var(--grey2)}
.cites b{color:var(--red);font-weight:500}
table{width:100%;border-collapse:collapse;font-family:var(--mono);font-size:12px}
th{text-align:left;font-size:9.5px;letter-spacing:1.2px;color:#fff;text-transform:uppercase;padding:9px 10px;background:var(--ink);font-weight:500}
td{padding:9px 10px;border-bottom:1px solid var(--line2)}
tr.clickable{cursor:pointer}tr.clickable:hover td{background:var(--red-lt)}
tr.sel td{background:var(--red-lt);box-shadow:inset 3px 0 0 var(--red)}
tr.row-in{animation:slide .3s ease backwards}
@keyframes slide{from{opacity:0;transform:translateX(-8px)}to{opacity:1;transform:none}}
.flag{color:var(--amber)}
.legend{display:flex;gap:18px;flex-wrap:wrap;font-family:var(--mono);font-size:10.5px;color:var(--grey2)}
.legend i{display:inline-block;width:18px;height:2px;vertical-align:middle;margin-right:6px}
.bar{height:7px;background:#E8E8E8;overflow:hidden}
.bar span{display:block;height:100%;background:var(--red);transition:width .3s}
.rowline{display:flex;justify-content:space-between;align-items:baseline;font-family:var(--mono);font-size:11.5px;padding:7px 0;border-bottom:1px solid var(--line2);gap:12px}
.rowline b{font-weight:500;text-align:right}
.big{font-family:var(--disp);font-weight:700;font-size:56px;line-height:1;color:var(--red)}
.loop{display:flex;flex-wrap:wrap;gap:7px;align-items:center;font-family:var(--mono);font-size:11px;color:var(--grey)}
.loop span{border:1px solid var(--line);padding:7px 10px;background:var(--bg)}
.loop em{color:var(--red);font-style:normal;font-weight:700}
.banner{background:var(--amber-bg);border:1px solid #E5C36A;border-left:4px solid var(--amber);padding:11px 15px;font-size:12.5px;color:#6B4A00;margin-bottom:18px}
.banner.info{background:#EEF4FB;border-color:#B9D3EE;border-left-color:#2C6DAF;color:#1E4670}
.spin{display:inline-block;width:11px;height:11px;border:2px solid rgba(255,255,255,.35);border-top-color:#fff;border-radius:50%;animation:sp .7s linear infinite;vertical-align:-1px;margin-right:7px}
.spin.d{border-color:rgba(0,0,0,.2);border-top-color:var(--ink)}
@keyframes sp{to{transform:rotate(360deg)}}
.hidden{display:none}
input[type=range]{-webkit-appearance:none;appearance:none;background:transparent;padding:0;border:0;height:22px}
input[type=range]::-webkit-slider-runnable-track{height:4px;background:var(--line)}
input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;width:16px;height:16px;background:var(--red);margin-top:-6px;cursor:pointer}
input[type=range]::-moz-range-track{height:4px;background:var(--line)}
input[type=range]::-moz-range-thumb{width:16px;height:16px;background:var(--red);border:0;cursor:pointer}
.kbdoc{border:1px solid var(--line);border-left:3px solid var(--red);background:var(--bg);padding:12px;margin-bottom:9px;cursor:pointer}
.kbdoc:hover{background:var(--red-lt)}
.kbdoc h4{font-family:var(--disp);font-size:15px;font-weight:600;text-transform:uppercase}
.kbdoc p{font-size:12.5px;color:var(--grey);margin-top:6px;max-height:48px;overflow:hidden}
.kbdoc.expanded p{max-height:none}
.toggle{display:flex;align-items:center;gap:9px;cursor:pointer;user-select:none;font-family:var(--mono);font-size:11.5px}
.tt{width:36px;height:20px;background:#C8C8C8;position:relative;flex-shrink:0;transition:.2s}
.tt::after{content:'';position:absolute;top:2px;left:2px;width:16px;height:16px;background:#fff;transition:.2s}
.toggle input{display:none}
.toggle input:checked + .tt{background:var(--red)}
.toggle input:checked + .tt::after{transform:translateX(16px)}
.verbs{display:grid;grid-template-columns:repeat(3,1fr);border:1px solid var(--line);margin-top:20px}
.verb{padding:18px;border-right:1px solid var(--line)}
.verb:last-child{border-right:0}
.verb .vn{font-family:var(--disp);font-weight:700;font-size:38px;color:var(--red);line-height:1}
.verb h3{color:var(--ink);font-size:16px;margin-top:5px}
.verb p{font-size:13px;color:var(--grey);margin-top:7px}

/* ── channel bridge ── */
.chcard{border:1px solid var(--line);padding:11px 12px;background:var(--bg);position:relative;overflow:hidden}
.chcard::before{content:'';position:absolute;left:0;top:0;bottom:0;width:4px;background:var(--c)}
.chcard .nm{font-family:var(--disp);font-weight:600;font-size:15px;text-transform:uppercase;letter-spacing:.4px}
.chcard .rg{font-family:var(--mono);font-size:9.5px;color:var(--grey2);margin-top:3px;text-transform:uppercase;letter-spacing:.8px}
.chcard .hd{font-family:var(--mono);font-size:10.5px;color:var(--grey);margin-top:6px}
.chdot{display:inline-block;width:7px;height:7px;border-radius:50%;background:var(--ok);margin-right:5px;vertical-align:1px}
.chdot.off{background:#C8C8C8}
.inbox{border:1px solid var(--line);max-height:430px;overflow-y:auto;background:var(--bg2)}
.inbox-item{padding:11px 12px;border-bottom:1px solid var(--line);cursor:pointer;background:var(--bg);position:relative;animation:pop .35s ease}
@keyframes pop{from{opacity:0;transform:translateY(-8px);background:#FFF3F4}to{opacity:1;transform:none}}
.inbox-item:hover{background:var(--red-lt)}
.inbox-item.sel{background:var(--red-lt);box-shadow:inset 3px 0 0 var(--red)}
.inbox-item .hdr{display:flex;justify-content:space-between;align-items:center;gap:8px;font-family:var(--mono);font-size:9.5px;color:var(--grey2);text-transform:uppercase;letter-spacing:.8px}
.inbox-item .orig{font-size:13.5px;margin-top:5px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.inbox-item .tr{font-size:12px;color:var(--grey);margin-top:3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-style:italic}
.chip{display:inline-block;width:9px;height:9px;border-radius:2px;margin-right:5px;vertical-align:-1px}
.unread{position:absolute;right:10px;top:10px;width:8px;height:8px;background:var(--red);border-radius:50%}
.tpane{border:1px solid var(--line);padding:13px;background:var(--bg)}
.tpane.orig{border-left:3px solid var(--ink)}
.tpane.eng{border-left:3px solid var(--red)}
.tpane .lbl{font-family:var(--mono);font-size:9.5px;color:var(--grey2);text-transform:uppercase;letter-spacing:1px;margin-bottom:6px}
.tpane .txt{font-size:14px;white-space:pre-wrap}
.roomcode{font-family:var(--disp);font-weight:700;font-size:44px;letter-spacing:8px;color:var(--red);line-height:1}

/* ── phone view ── */
.phone-body{background:#EDEDED;min-height:100vh;display:flex;flex-direction:column;font-family:var(--body)}
.ph-top{background:#2C2C2C;color:#fff;padding:12px 14px;display:flex;align-items:center;gap:10px;position:sticky;top:0;z-index:5}
.ph-top .av{width:34px;height:34px;background:var(--red);display:grid;place-items:center;font-family:var(--disp);font-weight:700;font-size:15px;flex-shrink:0}
.ph-top .nm{font-weight:600;font-size:15px}
.ph-top .st{font-size:11px;color:#B9B9B9;font-family:var(--mono)}
.ph-thread{flex:1;padding:14px;overflow-y:auto;display:flex;flex-direction:column;gap:10px}
.ph-msg{max-width:82%;padding:9px 12px;border-radius:4px;font-size:15px;line-height:1.45;white-space:pre-wrap;animation:pop .3s ease}
.ph-msg.out{align-self:flex-end;background:#95EC69;color:#111}
.ph-msg.in{align-self:flex-start;background:#fff;color:#111;border:1px solid #E0E0E0}
.ph-msg .meta{font-family:var(--mono);font-size:9.5px;color:#8A8A8D;margin-top:5px}
.ph-sys{align-self:center;font-family:var(--mono);font-size:10.5px;color:#8A8A8D;background:#DCDCDC;padding:3px 9px;border-radius:3px}
.ph-bar{background:#F7F7F7;border-top:1px solid #D6D6D6;padding:10px;display:flex;gap:8px;align-items:flex-end;position:sticky;bottom:0}
.ph-bar textarea{flex:1;font-family:var(--body);font-size:15px;border-radius:4px;min-height:42px;max-height:110px;padding:9px}
.ph-send{background:#07C160;color:#fff;border:0;padding:11px 16px;font-weight:600;font-size:14px;border-radius:4px;cursor:pointer;flex-shrink:0}
.ph-send:disabled{background:#B7E3C9}
.ph-quick{display:flex;gap:6px;flex-wrap:wrap;padding:0 10px 10px;background:#F7F7F7}
.ph-quick button{font-size:11px;padding:6px 9px;border:1px solid #D0D0D0;background:#fff;border-radius:14px;cursor:pointer;font-family:var(--body)}
.ph-setup{padding:20px;max-width:420px;margin:0 auto}
.ph-setup h2{font-family:var(--disp);text-transform:uppercase;font-size:24px}
@media(max-width:920px){.g2,.g3,.g4,.g5,.verbs{grid-template-columns:1fr}.pad{padding:0 15px}.masthead,.sechead{padding:20px 15px}h1{font-size:31px}.masthead h1,.sechead h1{font-size:31px}.rail{width:58px}.rbtn{height:84px;font-size:10px}.appname{display:none}.verb{border-right:0;border-bottom:1px solid var(--line)}}
</style>

