function buildCtx(hits){
  return hits.length?hits.map((h,i)=>`[DOC ${i+1}] ${h.d.t}${h.d.s==='assumption'?' (PROJECT ASSUMPTION)':''}\n${h.d.b.slice(0,620)}`).join('\n\n'):'NO DOCUMENTS MATCHED.';
