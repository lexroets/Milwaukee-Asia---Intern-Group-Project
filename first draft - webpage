function expand(q){let o=q.toLowerCase();for(const k in ALIAS)if(q.includes(k))o+=" "+ALIAS[k];return o;}
function tok(s){return (s.toLowerCase().match(/[a-z0-9]{3,}/g)||[]);}
function retrieve(q,n){
  const qt=[...new Set(tok(expand(q)))];if(!qt.length||!KB.length)return[];
  const N=KB.length,df={};
  qt.forEach(t=>{df[t]=KB.filter(d=>d._tok.includes(t)).length||0.5;});
  return KB.map(d=>{let s=0;
    qt.forEach(t=>{const tf=d._tok.filter(x=>x===t).length;
      if(tf)s+=(1+Math.log(tf))*Math.log(1+N/df[t]);
      if(d.t.toLowerCase().includes(t))s+=1.6;});
    return{d,s:s/Math.sqrt(d._tok.length||1)*10};})
    .filter(x=>x.s>0.12).sort((a,b)=>b.s-a.s).slice(0,n||3);
}
