<script>
/* ═════ base helpers ═════ */
const MEM={};
async function sget(k){try{const r=await window.storage.get(k);return r?JSON.parse(r.value):(MEM[k]??null)}catch(e){return MEM[k]??null}}
async function sset(k,v){MEM[k]=v;try{await window.storage.set(k,JSON.stringify(v))}catch(e){}}
function esc(s){const d=document.createElement('div');d.textContent=s==null?'':s;return d.innerHTML;}
function sleep(ms){return new Promise(r=>setTimeout(r,ms));}
function usd(n){return 'US$'+Math.round(n).toLocaleString();}
function setTxt(id,v){const e=document.getElementById(id);if(e)e.textContent=v;}
function nowHM(){const d=new Date();return String(d.getHours()).padStart(2,'0')+':'+String(d.getMinutes()).padStart(2,'0');}
function loadScript(src){return new Promise((res,rej)=>{
  if(document.querySelector('script[data-src="'+src+'"]'))return res();
  const s=document.createElement('script');s.src=src;s.setAttribute('data-src',src);
  s.onload=()=>res();s.onerror=()=>rej(new Error('Could not load '+src+' — check the network'));
  document.head.appendChild(s);});}

/* ═════ channels ═════ */
const CHANNELS={
 wechat:{name:'WeChat 微信',short:'微',colour:'#07C160',region:'China',lang:'Chinese',handle:'OA MilwaukeeCN'},
 kakao:{name:'KakaoTalk 카카오톡',short:'K',colour:'#FEE500',region:'Korea',lang:'Korean',handle:'@milwaukee_kr'},
 line:{name:'LINE',short:'L',colour:'#06C755',region:'Japan / Thailand',lang:'Japanese',handle:'@milwaukee'},
 whatsapp:{name:'WhatsApp',short:'W',colour:'#25D366',region:'India / SEA',lang:'English',handle:'+82 10 5512 0119'},
 zalo:{name:'Zalo',short:'Z',colour:'#0068FF',region:'Vietnam',lang:'Vietnamese',handle:'Milwaukee VN'}
};

/* ═════ nav ═════ */
const VIEWS=[['strategy','Strategy'],['channel','Channel desk'],['forecast','Forecast'],['market','White space'],['offer','Offer'],['convert','Conversion'],['counter','Counter'],['kb','Knowledge'],['setup','Setup']];
const nav=document.getElementById('nav');
VIEWS.forEach((v,i)=>{const b=document.createElement('button');b.className='rbtn'+(i===0?' on':'');b.id='nav'+i;
  b.innerHTML='<span class="n">0'+(i+1)+'</span>'+v[1];b.onclick=()=>go(i);nav.appendChild(b);});
function go(i){document.querySelectorAll('.rbtn').forEach((b,j)=>b.classList.toggle('on',j===i));
  document.querySelectorAll('.view').forEach(s=>s.classList.remove('on'));
  document.getElementById('v-'+VIEWS[i][0]).classList.add('on');window.scrollTo(0,0);
  if(i===1)UNSEEN=0,renderBusPill();}

/* ═════ config / usage / cache ═════ */
let CFG={mode:'auto',akey:'',gkey:'',gmodel:'gemini-2.5-flash',gver:'auto',gpool:[],budget:200};
let USE={date:today(),calls:0,cached:0};
let CACHE={},CACHEKEYS=[],GMODELS=[],LASTOK='',CALLTIMES=[],DEGRADED=false,DEGRADE_REASON='';
function today(){return new Date().toISOString().slice(0,10);}
function hash(s){let h=5381;for(let i=0;i<s.length;i++)h=((h*33)^s.charCodeAt(i))>>>0;return h.toString(36)+s.length.toString(36);}
function budgetLeft(){return Math.max(0,CFG.budget-USE.calls);}
function renderUsage(){
  const tot=USE.calls+USE.cached;
  setTxt('uCalls',USE.calls);setTxt('uCached',USE.cached);
  setTxt('uSaved',tot?Math.round(USE.cached/tot*100)+'%':'0%');
  setTxt('uLeft',budgetLeft());setTxt('lBudget',CFG.budget);
  const b=document.getElementById('uBar');if(b)b.style.width=Math.min(100,Math.round(USE.calls/Math.max(1,CFG.budget)*100))+'%';
  const p=document.getElementById('pillUse');
  if(p){p.textContent=USE.calls+' calls · '+USE.cached+' cached';
    p.className='pill link'+(budgetLeft()===0?' bad':budgetLeft()<15?' warn':'');}
  const s=document.getElementById('sBudget');if(s)s.value=CFG.budget;
}
function setBudget(){CFG.budget=+document.getElementById('sBudget').value;sset('cfg',CFG);renderUsage();}
async function bumpCalls(){USE.calls++;await sset('use',USE);renderUsage();}
async function bumpCached(){USE.cached++;await sset('use',USE);renderUsage();}
function cacheGet(k){return CACHE[k];}
function cacheSet(k,v){if(!(k in CACHE))CACHEKEYS.push(k);CACHE[k]=v;
  while(CACHEKEYS.length>80)delete CACHE[CACHEKEYS.shift()];sset('cache',{k:CACHEKEYS,v:CACHE});}
async function clearCache(){CACHE={};CACHEKEYS=[];await sset('cache',{k:[],v:{}});
  document.getElementById('warmMsg').innerHTML='Cache cleared.';}

/* ═════ providers ═════ */
const RETRYABLE=new Set([429,500,502,503,504]);
function anthBody(m,s,mx){const b={model:"claude-sonnet-4-6",max_tokens:mx||800,messages:m};if(s)b.system=s;return b;}
function anthText(d){return d.content.filter(c=>c.type==="text").map(c=>c.text).join("\n").trim();}
async function viaProxy(m,s,mx){
  const r=await fetch("https://api.anthropic.com/v1/messages",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(anthBody(m,s,mx))});
  if(!r.ok){const e=new Error("sandbox proxy unavailable ("+r.status+")");e.status=r.status;throw e;}
  return anthText(await r.json());
}
async function viaAnthropic(m,s,mx){
  if(!CFG.akey)throw new Error("no Anthropic key set");
  const r=await fetch("https://api.anthropic.com/v1/messages",{method:"POST",
    headers:{"Content-Type":"application/json","x-api-key":CFG.akey,"anthropic-version":"2023-06-01","anthropic-dangerous-direct-browser-access":"true"},
    body:JSON.stringify(anthBody(m,s,mx))});
  if(!r.ok){let t='';try{const j=await r.json();t=(j.error&&j.error.message)||'';}catch(e){}
    const e2=new Error("Anthropic "+r.status+(t?" — "+t:""));e2.status=r.status;throw e2;}
  return anthText(await r.json());
}
async function geminiCall(ver,model,messages,system,max){
  const body={contents:messages.map(m=>({role:m.role==='assistant'?'model':'user',parts:[{text:m.content}]})),
    generationConfig:{maxOutputTokens:max||800}};
  if(system)body.system_instruction={parts:[{text:system}]};
  const r=await fetch("https://generativelanguage.googleapis.com/"+ver+"/models/"+model+":generateContent",
    {method:"POST",headers:{"Content-Type":"application/json","x-goog-api-key":CFG.gkey},body:JSON.stringify(body)});
  if(!r.ok){let t='';try{const j=await r.json();t=(j.error&&j.error.message)||'';}catch(e){}
    const err=new Error("Google "+r.status+(t?" — "+t:""));err.status=r.status;throw err;}
  const d=await r.json(),c=d.candidates&&d.candidates[0];
  if(!c||!c.content)throw new Error("Google returned no text. Try another model.");
  return (c.content.parts||[]).map(p=>p.text||'').join("\n").trim();
}
async function tryModel(m,messages,system,max){
  const vers=(CFG.gver&&CFG.gver!=='auto')?[CFG.gver,'v1beta','v1','v1alpha']:['v1beta','v1','v1alpha'];
  const seen=new Set();let last=null;
  for(const v of vers){if(seen.has(v))continue;seen.add(v);
    try{return{out:await geminiCall(v,m,messages,system,max),v};}
    catch(e){last=e;if(e.status!==404)throw e;}}
  throw last||new Error("no API version accepted this model");
}
async function viaGemini(messages,system,max){
  if(!CFG.gkey)throw new Error("no Google AI Studio key set");
  const primary=CFG.gmodel||'gemini-2.5-flash';
  const pool=[primary,...(CFG.gpool||[]).filter(n=>n!==primary)].slice(0,4);
  let last=null;
  for(let mi=0;mi<pool.length;mi++){
    const tries=mi===0?3:2;
    for(let a=0;a<tries;a++){
      try{const r=await tryModel(pool[mi],messages,system,max);
        if(CFG.gver!==r.v||CFG.gmodel!==pool[mi]){CFG.gver=r.v;CFG.gmodel=pool[mi];sset('cfg',CFG);syncModelUI();}
        return r.out;}
      catch(e){last=e;if(!RETRYABLE.has(e.status))break;if(a<tries-1)await sleep(600*Math.pow(2,a));}
    }
    if(last&&last.status&&!RETRYABLE.has(last.status)&&last.status!==404)throw last;
  }
  throw new Error((last&&RETRYABLE.has(last.status))?"Google is busy — tried "+pool.length+" model(s) with retries. Capacity, not your key.":(last?last.message:"Google request failed"));
}
async function rateGuard(){
  const now=Date.now();
  CALLTIMES=CALLTIMES.filter(t=>now-t<60000);
  if(CALLTIMES.length>=8){await sleep(Math.min(60000-(now-CALLTIMES[0])+300,20000));
    CALLTIMES=CALLTIMES.filter(t=>Date.now()-t<60000);}
  CALLTIMES.push(Date.now());
}
async function callModel(messages,system,max){
  if(budgetLeft()===0)throw new Error("Daily budget of "+CFG.budget+" calls reached. Raise it in Setup.");
  await rateGuard();
  const order=CFG.mode==='auto'?['proxy','anthropic','gemini']:[CFG.mode];
  let last=null;
  for(const p of order){
    try{
      let out;
      if(p==='proxy')out=await viaProxy(messages,system,max);
      else if(p==='anthropic')out=await viaAnthropic(messages,system,max);
      else if(p==='gemini')out=await viaGemini(messages,system,max);
      else continue;
      LASTOK=p;await bumpCalls();renderConn();return out;
    }catch(e){last=e;}
  }
  throw new Error("No model connection ("+(last?last.message:"nothing configured")+"). Open Setup — add a free Google AI Studio key, or switch to offline demo mode.");
}
async function cachedCall(kind,keySrc,messages,system,max){
  const k=kind+':'+hash(keySrc),hit=cacheGet(k);
  if(hit!==undefined){await bumpCached();return{out:hit,cached:true};}
  const out=await callModel(messages,system,max);
  cacheSet(k,out);return{out,cached:false};
}
function classifyErr(m){
  if(/api key not valid|invalid.*key|unauthor|401|403|no .*key set|nothing configured/i.test(m))return'config';
  if(/budget/i.test(m))return'budget';
  if(/busy|capacity|high demand|overload|503|429|5\d\d/i.test(m))return'busy';
  return'other';
}
async function withFallback(live,offline,tag){
  try{const r=await live();DEGRADED=false;DEGRADE_REASON='';return r;}
  catch(e){
    const c=classifyErr(e.message);DEGRADED=true;
    DEGRADE_REASON=c==='config'?'Model connection is not working — open Setup and check your key. Answered with the offline engine meanwhile.'
      :c==='budget'?'Daily call budget reached. Answered with the offline engine.'
      :c==='busy'?'Google was at capacity. Answered with the offline engine; the live model should return shortly.'
      :'Live model unavailable ('+e.message.slice(0,70)+'). Answered with the offline engine.';
    if(c==='config'){const p=document.getElementById('pillConn');if(p){p.className='pill link bad';p.textContent='Check Setup';}}
    console.warn('ONE-CHANNEL '+tag+' → offline ['+c+']:',e.message);
    return offline();
  }
}
function degradedNote(){return DEGRADED?'<p class="note" style="color:var(--red)">⚠ '+esc(DEGRADE_REASON)+'</p>':'';}

/* ═════ offline language engines ═════ */
function detectLang(s){
  if(/[\uAC00-\uD7AF]/.test(s))return"Korean";
  if(/[\u0E00-\u0E7F]/.test(s))return"Thai";
  if(/[\u3040-\u30FF]/.test(s))return"Japanese";
  if(/[\u4E00-\u9FFF]/.test(s))return"Chinese";
  if(/[\u01A0\u01A1\u1EA0-\u1EF9]/.test(s))return"Vietnamese";
  return"English";
}
const OFFMAP=[
 {re:/임팩트|冲击|扳手|impact|กระแทก/i,sku:"M18 FIW2F12",d:"M18 FUEL™ impact wrench"},
 {re:/배터리|电池|แบตเตอรี่|batter|pin\b/i,sku:"M18 B5",d:"M18™ REDLITHIUM™ 5.0Ah battery"},
 {re:/작은 드릴|起子|드라이버|driver|subcompact|m12/i,sku:"M12 FID2",d:"M12 FUEL™ impact driver"},
 {re:/드릴|钻|สว่าน|khoan|drill/i,sku:"M18 FPD3",d:"M18 FUEL™ percussion drill"},
 {re:/작업등|工作灯|light|랜턴|đèn/i,sku:"M18 HAL",d:"M18™ site light"},
 {re:/one-?key|원키|tracker|asset/i,sku:"48-21-0004",d:"ONE-KEY™ Asset ID tag"},
 {re:/packout|팩아웃|storage/i,sku:"4932464244",d:"PACKOUT™ storage box"}
];
const OFFREPLY={
 Korean:"안녕하세요, 주문 확인했습니다. 총 {n}개 품목 접수되었으며 재고 확인 후 배송 일정 회신드리겠습니다. 감사합니다.",
 Chinese:"您好，订单已收到，共 {n} 个品项。我们确认库存后会回复发货时间。谢谢。",
 Thai:"สวัสดีครับ รับออร์เดอร์แล้ว รวม {n} รายการ จะตรวจสอบสต็อกและแจ้งกำหนดส่งกลับไปครับ",
 Japanese:"ご注文を承りました。全{n}品目です。在庫を確認のうえ、納期をご連絡いたします。",
 Vietnamese:"Đã nhận đơn hàng gồm {n} mặt hàng. Chúng tôi sẽ kiểm tra tồn kho và phản hồi lịch giao hàng.",
 English:"Thanks — order received, {n} line items. We'll confirm stock and come back with a delivery date."
};
/* glossary for offline translation */
const GLOSS=[
 [/임팩트\s*렌치/g,'impact wrench'],[/임팩트/g,'impact'],[/배터리/g,'battery'],[/드릴/g,'drill'],
 [/개(?=\s|$|,|\.)/g,' units'],[/부탁드립니다/g,'please'],[/안녕하세요/g,'hello'],[/사장님/g,'boss'],
 [/다음주/g,'next week'],[/화요일/g,'Tuesday'],[/가능할까요/g,'is it possible'],[/그리고/g,'and'],
 [/재고/g,'stock'],[/보증/g,'warranty'],[/충전/g,'charging'],[/작은/g,'small'],
 [/冲击扳手/g,'impact wrench'],[/电池/g,'battery'],[/起子机/g,'impact driver'],[/工作灯/g,'work light'],
 [/补货/g,'restock'],[/你好/g,'hello'],[/台(?=\s|$|,)/g,' units'],[/个(?=\s|$|,)/g,' units'],
 [/还有货吗/g,'still in stock?'],[/要/g,'need'],[/我们/g,'we'],[/另外/g,'also'],
 [/สว่านกระแทก/g,'hammer drill'],[/แบตเตอรี่/g,'battery'],[/จำนวน/g,'quantity'],[/ตัว/g,' units'],
 [/ก้อน/g,' units'],[/สวัสดีครับ/g,'hello'],[/ต้องการสั่ง/g,'would like to order'],
 [/สัปดาห์หน้า/g,'next week'],[/ได้ไหมครับ/g,'is that possible'],[/ส่งภายใน/g,'deliver within']
];
const DEMO_TR={};
function regDemo(orig,eng){DEMO_TR[hash(orig.replace(/\s+/g,' ').trim())]=eng;}
function offlineTranslate(text){
  const k=hash(text.replace(/\s+/g,' ').trim());
  if(DEMO_TR[k])return{english:DEMO_TR[k],exact:true};
  let t=text;GLOSS.forEach(([re,en])=>{t=t.replace(re,en);});
  t=t.replace(/[가-힣]+/g,'▮').replace(/[\u4E00-\u9FFF]+/g,'▮').replace(/[\u0E00-\u0E7F]+/g,'▮');
  return{english:'Glossary rendering (offline, not a full translation): '+t.replace(/▮+/g,'…').replace(/\s{2,}/g,' ').trim(),exact:false};
}
function numsIn(s,off){const out=[],re=/\d+/g;let m;
  while((m=re.exec(s))){const n=+m[0];if(n>0&&n<10000)out.push({n,at:off+m.index});}return out;}
function offlineParse(msg){
  const lang=detectLang(msg),lines=[],flags=[];
  const masked=msg.replace(/\bm\s?-?1[28]\b|\bmx\b/gi,m=>'\u00A7'.repeat(m.length))
                  .replace(/\d+(?:\.\d+)?\s?ah\b/gi,m=>'\u00A4'.repeat(m.length));
  let found=[];
  OFFMAP.forEach(p=>{const m=new RegExp(p.re.source,'i').exec(masked);if(m)found.push({p,i:m.index});});
  found.sort((a,b)=>a.i-b.i);
  found=found.filter((f,k)=>k===0||f.i-found[k-1].i>6);
  const used=new Set();
  found.forEach((f,k)=>{
    const end=k+1<found.length?found[k+1].i:masked.length,start=k===0?0:found[k-1].i;
    let pick=numsIn(masked.slice(f.i,end),f.i).find(x=>!used.has(x.at));
    if(!pick)pick=numsIn(masked.slice(start,f.i),start).reverse().find(x=>!used.has(x.at));
    if(!pick){flags.push("Quantity not stated for "+f.p.d+" — confirm with the distributor");return;}
    const vague=/maybe|아마|대충|some\s|약\s|\?/i.test(msg.slice(Math.max(0,pick.at-25),pick.at+6));
    used.add(pick.at);
    lines.push({sku:f.p.sku,description:f.p.d,qty:pick.n,certain:!vague});
    if(vague)flags.push("Quantity for "+f.p.d+" was hedged — confirm before shipping");
  });
  if(/mower|잔디|割草|new product|when.*korea/i.test(msg))flags.push("Product availability question — route to the MILWAUKEE Korea product manager");
  if(!lines.length)flags.push("No recognisable products found — the offline parser handles common lines only");
  const tr=offlineTranslate(msg);
  return{language:lang,english:tr.english,intent:lines.length?'order':'enquiry',confidence:lines.length?72:20,lines,flags,
    reply:(OFFREPLY[lang]||OFFREPLY.English).replace("{n}",lines.length),offlineTr:!tr.exact};
}
